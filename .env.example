# Google Gemini via Vertex AI (active provider), authenticated with a service account JSON
GOOGLE_CREDENTIALS_FILE=ai.json
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_MODEL=gemini-2.5-flash

# Mistral credentials (optional, not currently used)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Logging
LOG_LEVEL=INFO

# Currency assumed when a budget is given without one (and no profile currency)
DEFAULT_CURRENCY=INR

# An undated trip is assumed to start this many days from today, so live
# flights and hotels can still be priced (the assumption is shown to the user)
DEFAULT_TRIP_LEAD_DAYS=30

# Checkpoints (paused/resumable trips) + long-term user memory
#   memory   - lost on exit
#   sqlite   - local file, CLI can resume trips across runs (default)
#   postgres - shared by all API workers (docker compose up -d)
PERSISTENCE_BACKEND=sqlite
SQLITE_PATH=.data/travel_planner.db
DATABASE_URL=postgresql://travel:travel@localhost:5433/travel_planner

# Optional Redis cache for travel API responses (in-process cache when empty)
REDIS_URL=
CACHE_TTL_SECONDS=21600

# Travel data: mock (built-in demo data) or live (SerpApi + Open-Meteo)
TRAVEL_DATA_PROVIDER=mock
SERPAPI_API_KEY=
HTTP_TIMEOUT_SECONDS=20

# HTTP API keys: comma separated <key>:<user_id> pairs (required for the API)
API_KEYS=dev-key:alice

# Streamlit UI (an HTTP client of the API)
TRAVEL_API_URL=http://localhost:8000
# Optional: one key for every visitor (skips sign-in; single-user setups only)
TRAVEL_API_KEY=dev-key
UI_REQUEST_TIMEOUT_SECONDS=30
UI_STREAM_TIMEOUT_SECONDS=300
